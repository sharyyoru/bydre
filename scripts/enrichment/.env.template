# ===========================================
# ENRICHMENT API KEYS - Waterfall Strategy
# ===========================================
# Strategy: CallerKit (GCC phones) → Apollo → Hunter → Snov.io
# Expected hit rate: 80-95% vs 40-60% single provider

# -----------------------------
# STAGE 1: Phone Lookup (GCC)
# -----------------------------
# CallerKit - https://caller-kit.com/
# BEST FOR: Qatar, UAE, Saudi, Bahrain, Kuwait, Oman phone lookups
# Pricing: $99/mo for 20,000 lookups
# Returns: Name, Company, Email (if available), Social profiles
CALLERKIT_API_KEY=your_callerkit_api_key_here

# -----------------------------
# STAGE 2: Email Finders
# -----------------------------
# People Data Labs - https://www.peopledatalabs.com/
PDL_API_KEY=your_pdl_api_key_here

# Apollo.io - https://www.apollo.io/sign-up
# Free tier: 50 credits/month | Good for: Name + Company → Email
APOLLO_API_KEY=your_apollo_api_key_here

# Hunter.io - https://hunter.io/users/sign_up  
# Free tier: 25 searches + 50 verifications/month
HUNTER_API_KEY=your_hunter_api_key_here

# Snov.io - https://snov.io/ (Optional)
# Free tier: 50 credits/month | Good for: LinkedIn enrichment
SNOV_API_KEY=your_snov_api_key_here

# -----------------------------
# STAGE 3: Verification
# -----------------------------
# Hunter handles verification (included above)
# Alternative: ZeroBounce - https://zerobounce.net/
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here
